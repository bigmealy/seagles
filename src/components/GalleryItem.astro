---
interface Props {
  src?: string;
  alt?: string;
}

const { src, alt } = Astro.props;
---

{src ? (
  <img src={src} alt={alt ?? ""} class="w-full aspect-square object-cover rounded-lg" />
) : (
  <div class="w-full aspect-square rounded-lg border-2 border-dashed border-seagles-cream/30 bg-seagles-cream/10 flex items-center justify-center text-center p-4">
    <span class="text-sm text-seagles-cream/60">Photo placeholder — awaiting band photos</span>
  </div>
)}
