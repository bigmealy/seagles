---
import Nav from "./Nav.astro";
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
---

<header class="sticky top-0 z-30 border-b border-seagles-cream/10 bg-seagles-navy/70 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt="Seagles — An Eagles Tribute" width={48} height={48} class="h-12 w-12 rounded-full object-cover" />
      <span class="font-bold text-lg tracking-wide">SEAGLES</span>
    </a>
    <Nav />
  </div>
</header>
