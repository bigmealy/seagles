    <p>&copy; {year} Seagles — An Eagles Tribute</p>
    <a href="/contact" class="hover:text-seagles-orange transition-colors">Booking &amp; Contact</a>
  </div>
  <div class="max-w-5xl mx-auto px-4 pb-6">
