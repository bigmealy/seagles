---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";

// TODO: replace with real booking email address
const bookingEmail = "booking@seagles-placeholder.example";
---

<BaseLayout title="Booking & Contact">
  <Section>
    <h1 class="text-3xl font-bold mb-6">Booking &amp; Contact</h1>

    <p class="text-seagles-navy/80 mb-2 font-semibold">For venues &amp; promoters</p>
    <p class="text-seagles-navy/80 mb-6">
      Get in touch to check availability and book Seagles for your venue or event.
    </p>
    <a
      href={`mailto:${bookingEmail}`}
      class="inline-block bg-seagles-orange text-white font-semibold px-6 py-3 rounded hover:opacity-90 transition-opacity mb-10"
    >
      Email to book: {bookingEmail}
    </a>

    <p class="text-seagles-navy/80 mb-10">
      Fans with questions are welcome to reach out at the same address.
    </p>

    <!-- TODO: decide whether this becomes a real form (needs a backend — Azure
         Functions or a service like Formspree) or stays a mailto: link.
         See docs/technical-spec.md Open Questions. -->
    <div class="border-2 border-dashed border-seagles-navy/30 rounded-lg p-4 bg-seagles-navy/5 text-sm text-seagles-navy/70">
      Note: this page currently uses a plain mailto: link. Whether a proper
      contact form (with a backend to send email) is needed is still an open
      decision — see the technical spec.
    </div>
  </Section>
</BaseLayout>
