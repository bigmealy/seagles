---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

// Temporarily hidden pre-launch — Gigs page excluded from build, see CLAUDE.md
// import GigCard from "../components/GigCard.astro";
// import { getCollection } from "astro:content";
// const gigs = (await getCollection("gigs")).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
// const nextGig = gigs[0];
---

<BaseLayout title="Home">
  <Section class="text-center">
    <h1 class="sr-only">Seagles — An Eagles Tribute</h1>
    <Image src={logo} alt="Seagles — An Eagles Tribute" width={256} height={256} class="w-56 h-56 md:w-64 md:h-64 mx-auto rounded-full mb-6" />
    <p class="text-lg text-seagles-cream/80 mb-8">from North-East Scotland</p>
    <div class="flex flex-wrap gap-4 justify-center">
      {/* Temporarily hidden pre-launch — Gigs page excluded from build, see CLAUDE.md */}
      {/* <a href="/gigs" class="bg-seagles-orange text-white font-semibold px-6 py-3 rounded hover:opacity-90 transition-opacity">See Gigs</a> */}
      <a href="/contact" class="border-2 border-seagles-cream font-semibold px-6 py-3 rounded hover:bg-seagles-navy hover:text-seagles-cream transition-colors">Book the Band</a>
    </div>

    <div class="mt-10 max-w-2xl mx-auto aspect-video">
      <iframe
        class="w-full h-full rounded-lg"
        src="https://www.youtube-nocookie.com/embed/NR7Ns0iYDzI"
        title="Seagles — Eagles Tribute Band"
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  </Section>

  {/* Temporarily hidden pre-launch — Gigs page excluded from build, see CLAUDE.md
  <Section class="bg-seagles-cream rounded-lg">
    <h2 class="text-2xl font-bold mb-4 text-seagles-navy">Next up</h2>
    {nextGig ? (
      <GigCard date={nextGig.data.date} venue={nextGig.data.venue} location={nextGig.data.location} ticketUrl={nextGig.data.ticketUrl} />
    ) : (
      <p class="text-seagles-navy/70">No gigs announced yet — check back soon.</p>
    )}
    <a href="/gigs" class="inline-block mt-4 font-semibold text-seagles-navy hover:text-seagles-orange transition-colors">See all gigs &rarr;</a>
  </Section>
  */}

  {/* Temporarily hidden pre-launch — Gallery and Music pages excluded from build, see CLAUDE.md
  <Section>
    <h2 class="text-2xl font-bold mb-4">Hear us / See us</h2>
    <p class="text-seagles-cream/80 mb-4">Get a feel for the live show before you book or buy a ticket.</p>
    <div class="flex flex-wrap gap-4">
