---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
}

const { title, description, image = "/images/og-default.png", type = "website" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const musicGroupSchema = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: "Seagles",
  alternateName: "Seagles Tribute",
  genre: "Classic rock / Eagles tribute",
  description:
    "Seagles is an independent Eagles tribute band based in North-East Scotland, performing live shows for venues and events. Not affiliated with, endorsed by, or connected to the Eagles.",
  url: "https://www.seaglestribute.co.uk",
  logo: "https://www.seaglestribute.co.uk/favicon.svg",
  sameAs: ["https://facebook.com/seaglestribute"],
  foundingLocation: {
    "@type": "Place",
    name: "North-East Scotland, United Kingdom",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1c2c40" />
    <title>{title} | Seagles</title>

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Seagles" />
    <meta property="og:title" content={`${title} | Seagles`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Seagles`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(musicGroupSchema)} />
  </head>
  <body class="bg-seagles-black text-seagles-cream">
    <video
      class="fixed inset-0 -z-20 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      src="/videos/ocean-loop.mp4"
    />
    <div class="fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_50%_10%,color-mix(in_oklab,var(--color-seagles-orange)_14%,transparent),transparent_60%),linear-gradient(to_bottom,color-mix(in_oklab,#0d2539_85%,transparent),color-mix(in_oklab,var(--color-seagles-black)_90%,transparent))]"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
